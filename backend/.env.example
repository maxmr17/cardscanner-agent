# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cardscanner

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=30d

# OpenAI (GPT-4o for card identification)
OPENAI_API_KEY=sk-...

# eBay API (for market valuation)
# Register at developer.ebay.com — use the Browse API with OAuth
EBAY_APP_ID=your_ebay_app_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_OAUTH_TOKEN=

# Image storage (local for dev; replace with S3 bucket URL in production)
STORAGE_PATH=./uploads
PUBLIC_BASE_URL=http://localhost:3000
